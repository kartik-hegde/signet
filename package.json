{
  "name": "signett-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Signett SDK, evaluation framework, reference fixtures, benchmarks, and evidence.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspace=signett",
    "test": "npm run test --workspace=signett",
    "coverage": "npm run coverage --workspace=signett",
    "typecheck": "npm run typecheck --workspace=signett",
    "lint": "npm run lint --workspace=signett",
    "format:check": "npm run format:check --workspace=signett && npm run format:check:repo",
    "format:check:repo": "prettier --check packages/eval packages/chrome-agent benchmarks/signett-agent benchmarks/developer-productivity tooling .github/workflows eslint.config.mjs package.json README.md AGENTS.md --ignore-unknown",
    "package:check": "npm run package:check --workspace=signett",
    "smoke": "npm run smoke --workspace=signett",
    "validate": "npm run validate --workspace=signett",
    "docs:typecheck": "tsc -p docs/tsconfig.json",
    "docs:test": "npm run build --workspace=signett && vitest run docs/.vitepress/theme/webmcp.test.ts",
    "docs:build": "npm run build --workspace=signett && npm run docs:typecheck && npm run docs:build --workspace=signett",
    "docs:dev": "npm run docs:dev --workspace=signett",
    "docs:preview": "npm run docs:preview --workspace=signett",
    "tutorial:build": "npm run tutorial:build --workspace=signett",
    "tutorial:dev": "npm run tutorial:dev --workspace=signett",
    "tutorial:test": "npm run tutorial:test --workspace=signett",
    "test:eval": "node --test packages/eval/test/*.test.mjs",
    "build:chrome-agent": "npm run build --workspace=@signett/chrome-agent",
    "package:chrome-agent": "npm run package --workspace=@signett/chrome-agent",
    "test:chrome-agent": "npm run test --workspace=@signett/chrome-agent",
    "validate:chrome-agent": "npm run validate --workspace=@signett/chrome-agent",
    "test:agent:headless": "node packages/eval/cli.mjs agent",
    "test:agent:benchmark": "node --test benchmarks/signett-agent/test/*.test.mjs",
    "bench:agent:smoke": "node benchmarks/signett-agent/run.mjs",
    "test:reference:install": "npm run test:reference:install --workspace=signett",
    "test:reference": "npm run test:reference --workspace=signett",
    "test:reference:repeat": "npm run test:reference:repeat --workspace=signett",
    "test:reference:native:probe": "npm run test:reference:native:probe --workspace=signett",
    "test:reference:native": "npm run test:reference:native --workspace=signett",
    "eval": "node packages/eval/cli.mjs eval",
    "bench:p0": "node tooling/run-p0.mjs",
    "bench:p1": "node benchmarks/agent-effectiveness/run.mjs",
    "bench:p1:rescore": "node benchmarks/agent-effectiveness/run.mjs --rescore",
    "bench:p1:smoke": "P1_TRIALS=1 node benchmarks/agent-effectiveness/run.mjs --smoke",
    "test:agent": "node benchmarks/agent-effectiveness/run.mjs --test-agent",
    "bench:repair": "node packages/eval/cli.mjs eval fixtures/cypress-realworld-app/eval/repair.mjs --trials 5 --baseline raw-webmcp",
    "bench:repair:smoke": "node packages/eval/cli.mjs eval fixtures/cypress-realworld-app/eval/repair.mjs --trials 1 --baseline raw-webmcp",
    "test:developer-productivity": "npm run build && npm run test:p2:harness && npm run test:p3:harness",
    "test:p2:harness": "node benchmarks/developer-productivity/build-vs-buy/hidden/self-test.mjs",
    "test:p3:harness": "node benchmarks/developer-productivity/agent-readiness/hidden/self-test.mjs",
    "bench:p2": "node benchmarks/developer-productivity/build-vs-buy/run.mjs",
    "bench:p2:smoke": "P2_TRIALS=1 node benchmarks/developer-productivity/build-vs-buy/run.mjs",
    "bench:p3": "node benchmarks/developer-productivity/agent-readiness/run.mjs",
    "bench:p3:smoke": "P3_TRIALS=1 node benchmarks/developer-productivity/agent-readiness/run.mjs",
    "bench:safety": "node benchmarks/execution-safety/run.js --no-history",
    "bench:safety:artifact": "node benchmarks/execution-safety/run.js --no-history --output=.artifacts/safety.json",
    "bench:build-vs-buy": "node benchmarks/build-vs-buy/run.mjs",
    "bench:deterministic": "npm run bench:safety:artifact && node benchmarks/build-vs-buy/run.mjs --safety=.artifacts/safety.json --output=.artifacts/build-vs-buy && node tooling/run-p0.mjs --safety=.artifacts/safety.json --output=.artifacts/p0",
    "report:evidence": "node tooling/build-evidence-report.mjs",
    "demo": "node benchmarks/demo/server.mjs",
    "test:demo": "fixtures/cypress-realworld-app/node_modules/.bin/cypress run --project benchmarks/demo --config-file cypress.config.cjs",
    "saleor:preflight": "node benchmarks/integrations/saleor/scripts/preflight.mjs",
    "saleor:native-smoke": "node benchmarks/integrations/saleor/scripts/native-smoke.mjs",
    "saleor:oracle": "node benchmarks/integrations/saleor/scripts/oracle.mjs",
    "cal-diy:preflight": "node benchmarks/integrations/cal-diy/scripts/preflight.mjs",
    "cal-diy:native-smoke": "node benchmarks/integrations/cal-diy/scripts/native-smoke.mjs",
    "cal-diy:oracle": "node benchmarks/integrations/cal-diy/scripts/oracle.mjs",
    "cal-diy:agent": "node benchmarks/integrations/cal-diy/scripts/run-agent.mjs",
    "fixtures:materialize": "node tooling/materialize-fixture.mjs",
    "ci:classify:test": "node --test tooling/test/*.test.mjs",
    "evidence:validate": "node tooling/validate-evidence.mjs"
  },
  "license": "MIT"
}
