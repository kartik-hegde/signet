{
  "name": "signet-benchmarks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test:eval": "node --test eval/test/*.test.mjs",
    "bench:p0": "node scripts/run-p0.mjs",
    "bench:p1": "npx --yes --package=node@24 node agent-effectiveness/run.mjs",
    "bench:p1:rescore": "npx --yes --package=node@24 node agent-effectiveness/run.mjs --rescore",
    "bench:p1:smoke": "P1_TRIALS=1 npx --yes --package=node@24 node agent-effectiveness/run.mjs --smoke",
    "test:agent": "npx --yes --package=node@24 node agent-effectiveness/run.mjs --test-agent",
    "bench:safety": "npm --prefix execution-safety run bench -- --no-history",
    "bench:build-vs-buy": "node build-vs-buy/run.mjs",
    "report:evidence": "node scripts/build-evidence-report.mjs",
    "demo": "node demo/server.mjs",
    "test:demo": "apps/cypress-realworld-app/node_modules/.bin/cypress run --project demo --config-file cypress.config.cjs",
    "saleor:preflight": "node apps/saleor/scripts/preflight.mjs",
    "saleor:native-smoke": "node apps/saleor/scripts/native-smoke.mjs",
    "saleor:oracle": "node apps/saleor/scripts/oracle.mjs",
    "cal-diy:preflight": "node apps/cal-diy/scripts/preflight.mjs",
    "cal-diy:native-smoke": "node apps/cal-diy/scripts/native-smoke.mjs",
    "cal-diy:oracle": "node apps/cal-diy/scripts/oracle.mjs",
    "cal-diy:agent": "node apps/cal-diy/scripts/run-agent.mjs",
    "install:p0": "npx --yes --package=node@24 --package=yarn@1.22.22 yarn --cwd apps/cypress-realworld-app install --frozen-lockfile"
  }
}
